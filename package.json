{
  "name": "pnl-duels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch apps/worker/src/local.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsx scripts/prepare-vercel.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contracts": "tsx tests/contracts/evm.ts",
    "test:database": "tsx scripts/test-database.ts",
    "test:solana": "cd contracts/solana && anchor test",
    "providers:check": "tsx scripts/check-providers.ts",
    "readiness:check": "tsx scripts/check-readiness.ts",
    "scheduler:prepare": "tsx scripts/prepare-scheduler.ts",
    "gmgn:keygen": "tsx scripts/gmgn-keygen.ts",
    "deploy": "vercel --prod",
    "worker:check": "wrangler deploy --dry-run",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts && pnpm build && pnpm test:e2e",
    "deploy:cloudflare": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@noble/curves": "^1.9.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.2",
    "@wallet-standard/app": "^1.1.0",
    "bs58": "^6.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "hono": "^4.9.9",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "viem": "^2.37.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@eslint/js": "^9.36.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/geist-mono": "^5.2.6",
    "@fontsource/geist-sans": "^5.2.5",
    "@openzeppelin/contracts": "^5.4.0",
    "@playwright/test": "^1.55.1",
    "@solana/web3.js": "1.98.4",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.30",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  },
  "engines": {
    "node": "22.x"
  }
}
