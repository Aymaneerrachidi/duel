{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "env": { "NODEJS_HELPERS": "0" },
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{dist/index.html,apps/worker/assets/IBMPlexSans.ttf,apps/worker/assets/resvg.wasm}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/og/:path*", "destination": "/api/index" },
    { "source": "/d/:slug", "destination": "/api/index" },
    { "source": "/challenge/:slug", "destination": "/api/index" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https: wss:; font-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" }
    ] }
  ]
}
